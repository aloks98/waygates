{
    # Global options
    admin 0.0.0.0:2019
    email {$CLOUDFLARE_EMAIL}

    # ACME CA server (production or staging)
    # Production: https://acme-v02.api.letsencrypt.org/directory (default)
    # Staging: https://acme-staging-v02.api.letsencrypt.org/directory
    acme_ca {$ACME_CA_URL:https://acme-v02.api.letsencrypt.org/directory}

    # Use public DNS resolvers for DNS propagation checks
    acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# Base HTTP server for dynamic routes via Admin API
# Routes are added/removed dynamically by the backend
:443 {
    # Default response for unmatched requests
    respond "Not Found" 404
}

# HTTP to HTTPS redirect
:80 {
    redir https://{host}{uri} permanent
}

# Wildcard catch-all for unconfigured subdomains (optional)
# Uncomment and set your wildcard domain to show branded 404 page
# for any subdomain that doesn't have a configured route.

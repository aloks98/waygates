{
    # Global options
    admin 0.0.0.0:2019
    email {$CLOUDFLARE_EMAIL}

    # Use public DNS resolvers for DNS propagation checks
    acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# Catch all *.caddy.e412.in addresses and return custom 404
*.caddy.e412.in {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1 1.0.0.1
    }

    root * /etc/caddy/templates
    handle {
        templates
        rewrite * /404.html
        file_server
    }
}


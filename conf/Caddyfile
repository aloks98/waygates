{
    # ==========================================================
    # DO NOT MODIFY THIS FILE
    # All configuration is managed dynamically via the Admin API
    # by the Waygates backend service.
    # ==========================================================

    # Global options
    admin 0.0.0.0:2019
    email {$CLOUDFLARE_EMAIL}

    # ACME CA server (production or staging)
    # Production: https://acme-v02.api.letsencrypt.org/directory (default)
    # Staging: https://acme-staging-v02.api.letsencrypt.org/directory
    acme_ca {$ACME_CA_URL:https://acme-v02.api.letsencrypt.org/directory}

    # Use Cloudflare DNS for ACME challenges (wildcard certs)
    acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# Base HTTPS server - routes are managed via Admin API
# The backend syncs all proxy configurations on startup and every minute
:443 {
}

# HTTP to HTTPS redirect
:80 {
    redir https://{host}{uri} permanent
}

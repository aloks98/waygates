# Security snippet for blocking common exploits
# Import this snippet with: import /etc/caddy/snippets/security.caddy

# Block SQL injection attempts in URI
@sql_injection {
	path_regexp sql_inj (?i)(union.*select|select.*from|insert.*into|delete.*from|drop.*table|update.*set)
}
respond @sql_injection "Forbidden - SQL injection detected" 403 {
	close
}

# Block file injection/traversal attempts
@file_injection {
	path_regexp file_inj (\.\./|\.\.\\|%2e%2e|%252e)
}
respond @file_injection "Forbidden - Path traversal detected" 403 {
	close
}

# Block common XSS patterns
@xss_attack {
	path_regexp xss (?i)(<script|%3cscript|javascript:|vbscript:|onload=|onerror=)
}
respond @xss_attack "Forbidden - XSS detected" 403 {
	close
}

# Block PHP globals injection
@php_globals {
	path_regexp php_globals (?i)(globals\[|_request\[|_get\[|_post\[|_cookie\[|_files\[|_env\[|_server\[)
}
respond @php_globals "Forbidden - PHP globals injection detected" 403 {
	close
}

# Block malicious user agents
@bad_user_agents {
	header_regexp User-Agent (?i)(libwww-perl|wget|curl/|python-requests|scrapy|nikto|sqlmap|nmap|masscan)
}
respond @bad_user_agents "Forbidden - Blocked user agent" 403 {
	close
}

# Block common vulnerability scanners
@vuln_scanners {
	path_regexp scanners (?i)(wp-admin|wp-login|xmlrpc\.php|\.env|\.git|\.svn|\.htaccess|\.htpasswd|web\.config|phpinfo|phpmyadmin|adminer)
}
respond @vuln_scanners "Forbidden - Access denied" 403 {
	close
}

# =============================================================================
# Waygates Test Caddyfile
# =============================================================================
# This file is used for integration testing without TLS automation.
# =============================================================================

{
    # Disable automatic HTTPS for testing
    auto_https off

    # Admin API for reload operations
    admin localhost:2019
}

# Import all enabled proxy configurations
import sites/*.conf

# Import catch-all 404 handler (must be last)
import catchall.conf

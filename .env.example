# ============================================
# Waygates Environment Configuration
# ============================================
# Copy this file to .env and update the values

# ============================================
# Cloudflare Configuration (Required for SSL)
# ============================================
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read

CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ============================================
# ACME/Let's Encrypt Configuration
# ============================================
# Production (default): https://acme-v02.api.letsencrypt.org/directory
# Staging (for testing): https://acme-staging-v02.api.letsencrypt.org/directory
# Use staging first to avoid rate limits during testing

ACME_CA_URL=https://acme-v02.api.letsencrypt.org/directory

# ============================================
# Server Configuration
# ============================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# Database Configuration (PostgreSQL)
# ============================================

DB_HOST=postgres
DB_PORT=5432
DB_USER=waygates
DB_PASSWORD=waygates
DB_NAME=waygates

# ============================================
# Caddy Configuration
# ============================================
# Email for ACME certificate notifications (optional)

CADDY_EMAIL=your-email@example.com

# ============================================
# JWT Configuration (Required)
# ============================================
# JWT_SECRET must be at least 32 characters

JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ============================================
# Security Configuration
# ============================================

BCRYPT_COST=12
CORS_ORIGINS=http://localhost:8080

# ============================================
# Logging Configuration
# ============================================
# LOG_LEVEL: debug, info, warn, error
# LOG_FORMAT: json, console

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Default Admin User (Optional)
# ============================================
# Created on first startup if no users exist

DEFAULT_USER_NAME=Admin
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=changeme123

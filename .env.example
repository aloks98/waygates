# Cloudflare Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read

CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ACME/Let's Encrypt Configuration
# Production (default): https://acme-v02.api.letsencrypt.org/directory
# Staging (for testing): https://acme-staging-v02.api.letsencrypt.org/directory
# Use staging for testing to avoid rate limits
ACME_CA_URL=https://acme-v02.api.letsencrypt.org/directory

# ============================================
# Backend API Configuration
# ============================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./backend/data/caddy-manager.db

# For PostgreSQL (when DB_TYPE=postgres):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=caddymanager
# DB_PASSWORD=your-db-password
# DB_NAME=caddymanager

# Caddy Admin API
CADDY_ADMIN_URL=http://localhost:2019
CADDY_TIMEOUT=10s

# Default Admin User (not required)
DEFAULT_USER_NAME=
DEFAULT_USER_USERNAME=
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Security
BCRYPT_COST=10
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

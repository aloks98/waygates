# ============================================
# Waygates Environment Configuration
# ============================================
# Copy this file to .env and update the values

# ============================================
# Database Configuration (PostgreSQL)
# ============================================

DB_HOST=postgres
DB_PORT=5432
DB_USER=waygates
DB_PASSWORD=waygates
DB_NAME=waygates

# ============================================
# JWT Configuration (Required)
# ============================================
# JWT_SECRET must be at least 32 characters

JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# ============================================
# Server Configuration
# ============================================

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# Security Configuration
# ============================================

BCRYPT_COST=12
CORS_ORIGINS=http://localhost:8080

# ============================================
# Logging Configuration
# ============================================
# LOG_LEVEL: debug, info, warn, error
# LOG_FORMAT: json, console

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Default Admin User (Optional)
# ============================================
# Created on first startup if no users exist

DEFAULT_USER_NAME=Admin
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=changeme123

# ============================================
# TLS/HTTPS Configuration
# ============================================
# CADDY_ACME_PROVIDER controls how TLS certificates are obtained:
#   - off: Disable automatic HTTPS (default for development)
#   - http: Use HTTP challenge (requires ports 80/443 open to internet)
#   - cloudflare, route53, duckdns, digitalocean, hetzner, porkbun,
#     azure, vultr, namecheap, ovh: Use DNS challenge with that provider

CADDY_ACME_PROVIDER=off
CADDY_EMAIL=

# CADDY_ACME_RESOLVERS: comma-separated DNS servers used to verify that a DNS-01
# challenge record has propagated. Only applies to the DNS challenge providers.
#   - empty (default): 1.1.1.1,8.8.8.8
#   - "system": resolve through the host instead
# Let's Encrypt reads the _acme-challenge TXT record from your zone's public
# authoritative nameservers, so the propagation check has to look there too.
# Resolving through the host breaks when the host's resolver is authoritative
# for the zone internally (split-horizon DNS): it answers the NS lookup with an
# internal nameserver that cannot serve the public record, and issuance fails
# before validation is ever requested. Use "system" only when the host resolver
# can already see the zone's public nameservers.
CADDY_ACME_RESOLVERS=

# ============================================
# Trusted Proxies (real client IP behind a tunnel)
# ============================================
# Leave both empty when Caddy is the edge (direct LAN/VPN access works as-is).
# Set these only when Waygates sits behind an upstream proxy/tunnel, so IP-based
# ACL rules, ACL sessions, and audit logs see the real client instead of the
# tunnel connector's address.
#   CADDY_TRUSTED_PROXIES:   comma-separated CIDRs of the connector(s) to trust
#   CADDY_CLIENT_IP_HEADERS: comma-separated header(s) holding the real client IP
#
# Caddy only honors the client-IP header(s) for connections coming FROM a
# trusted-proxy range, so a client cannot spoof its IP. Trust ONLY the
# connector's range -- not broad private ranges -- if you also have direct LAN
# clients whose source IP you allow-list (otherwise those clients could spoof).
#
# Find the connector range first: deploy with these EMPTY, send one request
# through the tunnel, and look at the source IP Caddy records (its access log /
# the connection peer). That address is the connector -- put its range here.
#
# --- Cloudflare Tunnel (cloudflared) ---
# Real client is in Cf-Connecting-Ip. Caddy's peer is the cloudflared connector.
#   CADDY_TRUSTED_PROXIES=<cloudflared subnet, e.g. 172.18.0.0/16>
#   CADDY_CLIENT_IP_HEADERS=Cf-Connecting-Ip
#
# --- Pangolin (newt connector) ---
# Path: visitor -> Pangolin VPS (Traefik, sets X-Forwarded-For) -> WireGuard
# tunnel -> newt (homelab) -> Caddy. Caddy's peer is the NEWT connector (its
# local/container IP), NOT the visitor or the VPS; the real client is in
# X-Forwarded-For (X-Forwarded-For is the default header, so it can be omitted).
#   CADDY_TRUSTED_PROXIES=<newt subnet, e.g. the docker network newt shares>
#   CADDY_CLIENT_IP_HEADERS=X-Forwarded-For
CADDY_TRUSTED_PROXIES=
CADDY_CLIENT_IP_HEADERS=

# ============================================
# DNS Provider Credentials (set based on CADDY_ACME_PROVIDER)
# ============================================

# --- Cloudflare ---
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read
# CLOUDFLARE_API_TOKEN=

# --- AWS Route53 ---
# Create IAM user with Route53 permissions
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- DuckDNS ---
# Get your token from: https://www.duckdns.org
# DUCKDNS_API_TOKEN=

# --- DigitalOcean ---
# Create a personal access token: https://cloud.digitalocean.com/account/api/tokens
# DO_AUTH_TOKEN=

# --- Hetzner ---
# Create an API token: https://dns.hetzner.com/settings/api-token
# HETZNER_API_TOKEN=

# --- Porkbun ---
# Get API keys from: https://porkbun.com/account/api
# PORKBUN_API_KEY=
# PORKBUN_API_SECRET_KEY=

# --- Azure ---
# Create service principal with DNS Zone Contributor role
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=

# --- Vultr ---
# Create API key: https://my.vultr.com/settings/#settingsapi
# VULTR_API_KEY=

# --- Namecheap ---
# Enable API access: https://ap.www.namecheap.com/settings/tools/apiaccess/
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=

# --- OVH ---
# Create application: https://api.ovh.com/createToken/
# OVH_ENDPOINT=ovh-eu (or ovh-ca, ovh-us, etc.)
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# Cloudflare Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read

CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# ACME/Let's Encrypt Configuration
# Production (default): https://acme-v02.api.letsencrypt.org/directory
# Staging (for testing): https://acme-staging-v02.api.letsencrypt.org/directory
# Use staging for testing to avoid rate limits
ACME_CA_URL=https://acme-v02.api.letsencrypt.org/directory

# ============================================
# Backend API Configuration
# ============================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
# Used by both backend and docker-compose postgres service
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=waygates

# Caddy Admin API
CADDY_ADMIN_URL=http://caddy:2019
CADDY_TIMEOUT=10s

# Default Admin User (optional - created on first startup if no users exist)
DEFAULT_USER_NAME=Admin
DEFAULT_USER_USERNAME=admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=changeme123

# JWT Configuration
JWT_SECRET=change-this-to-a-random-secret-key-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Security
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=console

# UI Static File Serving
# The backend serves the UI static files directly
UI_ENABLED=true
UI_PATH=/app/ui
